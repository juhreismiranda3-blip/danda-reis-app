rules_version = '2';

// Regras do app Danda Reis.
// O app guarda todo o estado em documentos da coleção "app"
// (app/estado e os backups app/bkp_*). O aplicativo precisa ler o
// estado antes do login (para conseguir mostrar a tela de entrada),
// por isso a leitura de "app" fica liberada; a gravação exige estar
// logada. "pushTokens" guarda os tokens de notificação de cada
// dispositivo (gravados após o login).

service cloud.firestore {
  match /databases/{database}/documents {

    match /app/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /pushTokens/{token} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Qualquer outra coleção fica bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
